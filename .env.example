# ── העתיקו קובץ זה ל-.env ומלאו את הערכים ────────────────────────────────
# .env נמצא ב-.gitignore ולא נכנס ל-git. אין להעלות אותו לשום מקום.

# ══ Firebase ═══════════════════════════════════════════════════════════════
# מתוך Firebase Console → Project settings → General → Your apps → Web app.
#
# הערכים האלה אינם סוד: הם נצרבים לתוך ה-build ונשלחים לכל דפדפן, וכך זה
# אמור להיות. מה ששומר על הנתונים הוא firestore.rules, לא הסתרת המפתח.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# איזו סביבה באותו פרויקט Firestore. קובע את שורש הנתונים:
#   envs/test/...   מול   envs/prod/...
# בפיתוח מקומי השאירו test, אחרת עורכים נתונים אמיתיים.
VITE_FIREBASE_ENV=test

# ⚠️ סוד — לסקריפטי הניהול והייבוא מול Firebase Admin (למשל firebase-import,
#    sync-storage-claims, backfill-*). מפתח שרת עם גישה מלאה שעוקף כל כלל
#    אבטחה. אין לו קידומת VITE_ בכוונה: הוא לעולם לא נכנס ל-build ולא מגיע
#    לדפדפן.
#    Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

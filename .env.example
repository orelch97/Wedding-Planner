# ── העתיקו קובץ זה ל-.env ומלאו את הערכים ────────────────────────────────
# .env נמצא ב-.gitignore ולא נכנס ל-git. אין להעלות אותו לשום מקום.

# ── CockroachDB ───────────────────────────────────────────────────────────
# מתוך CockroachDB Cloud → הקלאסטר → Connect → General connection string.
#
# ⚠️ סוד. הוא נשאר בשרת בלבד ולעולם לא מגיע לדפדפן. שימו לב שאין לו
#    קידומת VITE_ — כל משתנה שמתחיל ב-VITE_ נצרב לתוך ה-build הפומבי.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# ── השרת ──────────────────────────────────────────────────────────────────
PORT=3001

# production מפעיל את דגל Secure בעוגיית הסשן ומגיש את dist/.
# בפיתוח מקומי (http://localhost) יש להשאיר את השורה מוערת.
# NODE_ENV=production

# הפעילו רק אם השרת יושב מאחורי reverse proxy (Render / Fly / nginx),
# אחרת אפשר לזייף כתובת IP ולעקוף את הגבלת הקצב על ניסיונות התחברות.
# TRUST_PROXY=1

# ── דואר יוצא (איפוס סיסמה) ───────────────────────────────────────────────
# בלי ההגדרות האלה המערכת לא נופלת, אבל גם לא שולחת כלום: קישור האיפוס
# מודפס ללוג השרת בלבד. כדי שהמייל באמת יגיע — מלאו את כל ארבעת הראשונים.
#
# ⚠️ SMTP_PASS הוא סוד. ב-Gmail זו אינה סיסמת החשבון אלא App Password
#    בן 16 תווים (נדרש אימות דו-שלבי מופעל).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_FROM="תכנון החתונה שלנו <you@gmail.com>"

# כתובת הבסיס לקישורים במייל, כולל הסכמה. בפיתוח זו כתובת ה-Vite.
APP_URL=http://localhost:5173

# ── הלקוח ─────────────────────────────────────────────────────────────────
# כתובת ה-API. אם היא ריקה, האפליקציה רצה במצב מקומי בלבד (localStorage),
# בלי התחברות ובלי סנכרון. '/api' עובד גם בפיתוח (דרך ה-proxy של Vite)
# וגם בייצור כשהשרת מגיש את dist/.
VITE_API_URL=/api

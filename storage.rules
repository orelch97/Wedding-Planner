rules_version = '2';

/* =============================================================================
 *  storage.rules — הרשאות על הקבצים עצמם
 * -----------------------------------------------------------------------------
 *  ב-Firestore נשמרת רק המטא-דאטה של המסמך; התוכן יושב כאן. בלי הכללים
 *  האלה כל מי שמחזיק בקישור יכול להוריד חוזים חתומים של ספקים.
 *
 *  נתיב הקובץ:  {env}/weddings/{weddingId}/vendor-files/{fileId}
 *
 *  ⚠ ההרשאה נבדקת מול **custom claim** ולא מול Firestore.
 *    firestore.get() בתוך storage.rules מוחזר כ-403 בפרויקט הזה — נבדק
 *    אמפירית: אותה העלאה בדיוק עוברת ברגע שהתנאי מוסר. במקום זאת
 *    functions/index.js שומר claim בשם p_test / p_prod ובו מפת
 *    weddingId→permission כדי שהיקפים ותפקידים ייאכפו גם ב-Storage.
 * ========================================================================== */

service firebase.storage {
  match /b/{bucket}/o {

    match /{env}/weddings/{weddingId}/vendor-files/{fileId} {

      function canReadVendors() {
        return request.auth != null
               && request.auth.token['p_' + env] is map
               && request.auth.token['p_' + env][weddingId]
                    in ['vendor_read', 'vendor_write', 'owner'];
      }

      function canWriteVendors() {
        return request.auth != null
               && request.auth.token['p_' + env] is map
               && request.auth.token['p_' + env][weddingId]
                    in ['vendor_write', 'owner'];
      }

      allow read: if canReadVendors();

      //  התקרה זהה ל-MAX_FILE_BYTES בקוד. בלי מגבלה כאן חשבון אחד יכול
      //  למלא את מכסת האחסון של כל הפרויקט.
      allow create, update: if canWriteVendors()
                && request.resource.size < 5 * 1024 * 1024;

      allow delete: if canWriteVendors();
    }

    match /{env}/weddings/{weddingId}/countdown-background {
      function memberOf() {
        return request.auth != null
               && request.auth.token['p_' + env] is map
               && weddingId in request.auth.token['p_' + env];
      }

      function ownerOf() {
        return request.auth != null
               && request.auth.token['p_' + env] is map
               && request.auth.token['p_' + env][weddingId] == 'owner';
      }

      allow read: if memberOf();
      allow write: if ownerOf()
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    //  כל נתיב אחר — חסום.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

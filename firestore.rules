rules_version = '2';

/* =============================================================================
 *  firestore.rules — שכבת ההרשאות
 * -----------------------------------------------------------------------------
 *  זה התחליף ל-55 מדיניות ה-RLS שהיו ב-CockroachDB. באפליקציה שכותבת
 *  ל-Firestore ישירות מהדפדפן, הקובץ הזה הוא **הגבול היחיד**. כל מה שהוא
 *  מתיר — כל אחד עם חשבון יכול לעשות, גם בלי לעבור דרך ה-UI שלנו.
 *
 *  מודל ההרשאות, זהה למה שהיה במסד:
 *    • חבר   — קיים מסמך members/{uid} תחת החתונה
 *    • תפקיד — owner / editor / viewer
 *    • היקף  — scopes: ['all'] או תת-קבוצה של guests|vendors|finance|checklist
 *    • בעלים — weddings/{id}.ownerId == uid  (עריכת הגדרות, הזמנות, חברים)
 *
 *  מיפוי אוסף→היקף (חייב להישאר זהה ל-SCOPE_OF_COLLECTION ב-src/lib/firebase.js):
 *    guests, tables      → 'guests'
 *    vendors, files      → 'vendors'
 *    budget              → 'finance'
 *    checklist           → 'checklist'
 *
 *  ⚠ כל get() כאן הוא קריאה בתשלום. לכן הבדיקות בנויות סביב מסמך חברות
 *    אחד לכל חתונה, ולא סביב שדות מפוזרים.
 * ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    match /envs/{env} {

      function uid() {
        return request.auth != null ? request.auth.uid : null;
      }

      function memberPath(weddingId) {
        return /databases/$(database)/documents/envs/$(env)/weddings/$(weddingId)/members/$(uid());
      }

      function isMember(weddingId) {
        return uid() != null && exists(memberPath(weddingId));
      }

      function member(weddingId) {
        return get(memberPath(weddingId)).data;
      }

      function isOwner(weddingId) {
        return uid() != null
               && get(/databases/$(database)/documents/envs/$(env)/weddings/$(weddingId))
                    .data.ownerId == uid();
      }

      //  viewer רשאי לקרוא בלבד. owner ו-editor רשאים לכתוב.
      function canWriteRole(weddingId) {
        return isOwner(weddingId)
               || (isMember(weddingId) && member(weddingId).role == 'editor');
      }

      function hasScope(weddingId, scope) {
        return isMember(weddingId) &&
               (!('scopes' in member(weddingId)) ||
                !(member(weddingId).scopes is list) ||
                member(weddingId).scopes.size() == 0 ||
                'all' in member(weddingId).scopes ||
                scope in member(weddingId).scopes);
      }

      function startsAtRevisionOne() {
        return request.resource.data.revision is int
               && request.resource.data.revision == 1;
      }

      function advancesRevision() {
        return request.resource.data.revision is int
               && ((!('revision' in resource.data)
                    && request.resource.data.revision == 1)
                   || ('revision' in resource.data
                       && resource.data.revision is int
                       && request.resource.data.revision == resource.data.revision + 1));
      }

      function isUuid(value) {
        return value is string
               && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
      }

      function validVendorReference(data) {
        return !('vendorId' in data) ? true
               : data.vendorId is string ? isUuid(data.vendorId)
               : data.vendorId == null ? true
               : false;
      }

      /* ── שורש הסביבה ─────────────────────────────────────────────────── */
      //  מסמך המטא של הסביבה נכתב רק על ידי סקריפט ההעברה (Admin SDK,
      //  שעוקף את הכללים האלה לחלוטין).
      allow read: if uid() != null;
      allow write: if false;

      /* ── משתמשים ─────────────────────────────────────────────────────── */
      //  כל אחד רואה רק את עצמו. רשימת המשתמשים אינה ניתנת לסריקה, אחרת
      //  כל בעל חשבון היה יכול לשלוף את כל כתובות המייל במערכת.
      match /users/{userId} {
        allow read: if uid() == userId;
        allow create, update: if uid() == userId;
        allow delete: if false;
      }

      /* ── חתונות ──────────────────────────────────────────────────────── */
      match /weddings/{weddingId} {
        allow read: if isMember(weddingId);

        //  שם, תאריך, שמות בני הזוג ויעד התקציב — בעלים בלבד, בדיוק כמו
        //  מדיניות weddings_update הישנה שנשענה על owner_id.
        allow update: if isOwner(weddingId)
                      && request.resource.data.ownerId == resource.data.ownerId;

        //  הרשמה: משתמש פותח לעצמו חתונה, ורק כאשר הוא הבעלים שלה.
        //  בלי זה אי-אפשר להירשם בכלל בלי שרת.
        allow create: if uid() != null && request.resource.data.ownerId == uid();
        allow delete: if false;

        /* ── חברים ──────────────────────────────────────────────── */
        match /members/{memberId} {
          //  פרטיות: רק הבעלים קורא את כל רשימת החברים (מייל, תפקיד, היקפים
          //  ונוכחות חשופים שם). חבר רגיל קורא אך ורק את מסמך החברות של עצמו.
          allow read: if isOwner(weddingId) || uid() == memberId;

          //  ביצת הבעלות: כדי להיות בעלים צריך מסמך חברות, וכדי ליצור מסמך
          //  חברות צריך להיות בעלים. לכן יצירת שורת הבעלים של עצמי נשענת
          //  על weddings/{id}.ownerId ולא על החברות.
          allow create: if uid() == memberId
                        && request.resource.data.role == 'owner'
                        && get(/databases/$(database)/documents/envs/$(env)/weddings/$(weddingId))
                             .data.ownerId == uid();

          //  נוכחות: כל חבר מסמן שהוא כאן, על השורה של עצמו בלבד ורק על
          //  השדה הזה בלבד. שינויי תפקיד עוברים דרך Cloud Functions כדי
          //  לרענן גם את claims של Storage.
          allow update: if uid() == memberId
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['lastSeenAt']);

          //  שינוי הרשאות, הסרה ועזיבה נעשים דרך Cloud Functions בלבד.
          allow delete: if false;
        }

        /* ── הגדרות החתונה ─────────────────────────────────────────────── */
        //  ההגדרות מרכזות מפתחות מכמה היקפים (יעד תקציב, קטגוריות מוזמנים).
        //  כל היקף במסמך נפרד, מפני שכללי Firestore אינם מסתירים שדות במסמך.
        match /settings/{docId} {
          allow read: if isOwner(weddingId)
                      || (docId == 'finance' && hasScope(weddingId, 'finance'))
                      || (docId == 'guests' && hasScope(weddingId, 'guests'));
          allow write: if (docId == 'finance'
                           && hasScope(weddingId, 'finance')
                           && canWriteRole(weddingId))
                       || (docId == 'guests'
                           && hasScope(weddingId, 'guests')
                           && canWriteRole(weddingId))
                       || (docId == 'owner' && isOwner(weddingId));
        }

        /* ── נתוני המסכים ──────────────────────────────────────────────── */
        match /guests/{docId} {
          allow read:  if hasScope(weddingId, 'guests');
          allow create: if hasScope(weddingId, 'guests') && canWriteRole(weddingId) && startsAtRevisionOne();
          allow update: if hasScope(weddingId, 'guests') && canWriteRole(weddingId) && advancesRevision();
          allow delete: if false;
        }

        match /tables/{docId} {
          allow read:  if hasScope(weddingId, 'guests');
          allow create: if hasScope(weddingId, 'guests') && canWriteRole(weddingId) && startsAtRevisionOne();
          allow update: if hasScope(weddingId, 'guests') && canWriteRole(weddingId) && advancesRevision();
          allow delete: if false;
        }

        match /vendors/{docId} {
          allow read:  if hasScope(weddingId, 'vendors');
          allow create: if hasScope(weddingId, 'vendors')
                        && canWriteRole(weddingId)
                        && startsAtRevisionOne()
                        && isUuid(docId)
                        && request.resource.data.id == docId;
          allow update: if hasScope(weddingId, 'vendors')
                        && canWriteRole(weddingId)
                        && advancesRevision()
                        && resource.data.id == docId
                        && request.resource.data.id == resource.data.id;
          allow delete: if false;
        }

        //  מטא-דאטה של מסמכים מצורפים. הקובץ עצמו יושב ב-Storage ומוגן
        //  בנפרד ב-storage.rules.
        match /files/{docId} {
          allow read:  if hasScope(weddingId, 'vendors');
          allow create, update: if hasScope(weddingId, 'vendors')
                                && canWriteRole(weddingId)
                                && validVendorReference(request.resource.data);
          allow delete: if false;
        }

        match /budget/{docId} {
          allow read:  if hasScope(weddingId, 'finance');
          allow create: if hasScope(weddingId, 'finance')
                        && canWriteRole(weddingId)
                        && startsAtRevisionOne()
                        && validVendorReference(request.resource.data);
          allow update: if hasScope(weddingId, 'finance')
                        && canWriteRole(weddingId)
                        && advancesRevision()
                        && validVendorReference(request.resource.data);
          allow delete: if false;
        }

        match /checklist/{docId} {
          allow read:  if hasScope(weddingId, 'checklist');
          allow create: if hasScope(weddingId, 'checklist') && canWriteRole(weddingId) && startsAtRevisionOne();
          allow update: if hasScope(weddingId, 'checklist') && canWriteRole(weddingId) && advancesRevision();
          allow delete: if false;
        }
      }

      /* ── הזמנות ──────────────────────────────────────────────────────── */
      //  ההזמנה מכילה טוקן, ולכן היא לא נקראת מהדפדפן כלל: המימוש עובר
      //  דרך Cloud Function עם הרשאות אדמין. הבעלים רואה את ההזמנות שהנפיק
      //  כדי לבטל אותן.
      match /invites/{inviteId} {
        allow read: if isOwner(resource.data.weddingId);
        allow write: if false;
      }

      /* ── Passkeys ─────────────────────────────────────────────────────── */
      //  מפתחות ציבוריים ואתגרי WebAuthn. נכתבים ונקראים אך ורק ב-Cloud
      //  Functions (Admin SDK עוקף את הכללים). חסימה מפורשת ולא הסתמכות
      //  על ברירת המחדל: קריאה מהדפדפן הייתה חושפת אילו כתובות מייל רשומות,
      //  וכתיבה הייתה מאפשרת לרשום מפתח לחשבון של מישהו אחר.
      match /passkeys/{credentialId} {
        allow read, write: if false;
      }

      match /webauthnChallenges/{challengeId} {
        allow read, write: if false;
      }
    }

    //  כל מה שלא הוזכר במפורש — חסום.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
